# PayPal sandbox REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Anthropic API key, used to read receipt photos with Claude vision.
# Leave empty to run in demo mode with a sample receipt.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Public URL of this server. PayPal redirects payers back here.
BASE_URL=http://localhost:3000
PORT=3000
