# PayPal sandbox REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID= 
PAYPAL_CLIENT_SECRET= 

# Free Google Gemini API key from https://aistudio.google.com/apikey (no credit card needed).
# Used to read receipt photos. Leave empty to run in demo mode with a sample receipt.
GEMINI_API_KEY= 
# GEMINI_MODEL=gemini-3.5-flash-lite

# Public URL of this server. PayPal redirects payers back here.
BASE_URL=http://localhost:3000
PORT=3000
